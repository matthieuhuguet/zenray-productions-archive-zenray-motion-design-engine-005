def match_font(ref: np.ndarray, text: str, files: list[str] | None = None, exclude_families: list[str] | None = None,
               top_k: int | None = None, fit_deltas: bool = True, workers: int | None = None,
               overrides: dict | None = None) -> dict:
    """Rank the dataset's font files against a reference mask of a known string and fit the best ones.
    files restricts the candidates (default: every usable file of features.jsonl); exclude_families removes
    families (used by the verifier to simulate a font absent from the dataset). Returns coarse ranking, fine fits
    sorted by loss, the best fit and whether it reaches the match rule (vector.fit.match)."""
    cfg = {**_cfg(), **(overrides or {})}
    top_k = top_k or cfg["top_k"]
    workers = workers or cfg["workers"]
    ref = np.asarray(ref, np.float32)
    recs = feature_records()
    pool_files = files or [f for f, r in recs.items() if r.get("usable")]
    excl = set(exclude_families or [])
    pool_files = [f for f in pool_files if recs.get(f, {}).get("family") not in excl]
    st = M.stroke_widths(ref)
    ref_stem = st.get("p50") if st else None
    jobs = [(f, text, ref, ref_stem, cfg) for f in sorted(pool_files)]
    with ProcessPoolExecutor(workers) as pool:
        coarse = list(pool.map(coarse_one, jobs, chunksize=max(1, len(jobs) // (workers * 4))))
        ok = sorted([c for c in coarse if "loss" in c], key=lambda c: c["loss"])
        fine = list(pool.map(fine_one, [(c, text, ref, cfg, fit_deltas) for c in ok[:top_k]]))
    fine.sort(key=lambda r: r["loss"])
    # 12 October 2026: the polish_top best fits get the profiled axis polish (see polish_axes), sequentially, each
    # with its own pool of workers.
    for i in range(min(len(fine), (cfg.get("polish") or {}).get("top", 0))):
        if not fine[i]["match"] or (cfg.get("polish") or {}).get("always", True):
            fine[i] = polish_axes(fine[i], text, ref, cfg, workers)
    fine.sort(key=lambda r: r["loss"])
    best = fine[0] if fine else None
    return {"text": text, "canvas": [ref.shape[1], ref.shape[0]], "candidates": len(jobs),
            "coarse_errors": sum(1 for c in coarse if "error" in c),
            "coarse": [{k: c.get(k) for k in ("family", "file", "loss", "iou", "edge_mean")} for c in ok[:cfg["report_coarse"]]],
            "fits": fine, "best": best, "match": bool(best and best["match"])}
