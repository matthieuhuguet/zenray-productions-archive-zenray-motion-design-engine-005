def build_font(params: dict, out_file: Path, family_name: str) -> dict:
    """Build the .ttf of params: instance the base, write transformed points of every adjusted glyph (composites
    become simple glyphs), advances, and a new family name (an OFL Reserved Font Name is never reused).
    Deterministic: two builds of the same params give the same bytes (sha256 returned)."""
    from array import array
    from fontTools.ttLib.tables import ttProgram
    from fontTools.ttLib.tables._g_l_y_f import Glyph, GlyphCoordinates
    import tempfile
    out_file = Path(out_file)
    out_file.parent.mkdir(parents=True, exist_ok=True)
    tmp = Path(tempfile.mkdtemp(prefix="zrmd-font-")) / "base.ttf"
    instance_base(params["base"]["file"], params["base"]["axes"], tmp)
    names = list(params["glyphs"])
    G = Glyphs(str(tmp), names)
    tt = G.tt
    glyf, hmtx = tt["glyf"], tt["hmtx"]
    for n in names:
        d = G.data[n]
        gp = params["glyphs"][n]
        pts = transform(G, n, params, True)
        g = Glyph()
        if len(pts):
            g.numberOfContours = len(d["ends"])
            g.endPtsOfContours = list(d["ends"])
            g.coordinates = GlyphCoordinates([(int(round(x)), int(round(y))) for x, y in pts])
            g.flags = array("B", [int(f) for f in d["on"]])
            g.program = ttProgram.Program()
            g.program.fromBytecode(b"")
        else:
            g.numberOfContours = 0
        glyf[n] = g
        if len(pts):
            g.recalcBounds(glyf)
        advance = d["advance"] * gp.get("scale_x", 1.0) + gp.get("advance_units", 0.0)
        hmtx[n] = (int(round(advance)), int(getattr(g, "xMin", 0)))
    name = tt["name"]
    ps = "".join(ch for ch in family_name if ch.isalnum())[:60]
    for rec in list(name.names):
        if rec.nameID in (1, 16):
            rec.string = family_name
        elif rec.nameID == 4:
            rec.string = f"{family_name} Regular"
        elif rec.nameID == 6:
            rec.string = f"{ps}-Regular"
        elif rec.nameID == 3:
            rec.string = f"{ps};{params.get('date', '')}"
    _fix_timestamps(tt)
    tt.save(str(out_file))
    tmp.unlink()
    tmp.parent.rmdir()
    data = out_file.read_bytes()
    return {"file": str(out_file), "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}


def render_built(font_file: str, params: dict, canvas: tuple) -> np.ndarray:
    """Render the string with the BUILT font through HarfBuzz (the real pipeline), with the layout parameters."""
    L = params["layout"]
    m = R.render_text_at(L["text"], font_file, L["size"], tuple(L["origin"]), canvas, None, L["tracking_em"],
                         L.get("deltas"))
    b = float(L.get("blur_px") or 0.0)            # 12 October 2026 (F3), see render_params
    return ndi_gaussian(m, b) if b > 0.05 else m
